#!/usr/bin/env bash
# every: 5h
# machines: all
# Auto-sync (rule W6): commit all changes in the workspace repo and in every nested project repo that has a
# remote, pull what other machines pushed (rebase; a conflict is undone and reported), then push. Repos
# without a remote are left alone. SSH runs in batch mode, so a locked key makes the push fail (retried
# later) instead of popping up a passphrase dialog.
set -u
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=20"
root=$PWD
msg="Auto-sync $(date '+%F %H:%M')"
fail=0

exclude_nested() {   # $1 = repo dir: keep repos nested inside it out of its index (no submodules)
  local dir=$1 ex rel g
  ex="$dir/.git/info/exclude"; mkdir -p "$dir/.git/info"
  while IFS= read -r g; do
    rel=${g#"$dir"/}; rel=${rel%/.git}
    grep -qxF "/$rel/" "$ex" 2>/dev/null || printf '/%s/\n' "$rel" >> "$ex"
    [ -n "$(git -C "$dir" ls-files -- "$rel" | head -1)" ] && git -C "$dir" rm -r -q --cached -- "$rel"
  done < <(find "$dir" -mindepth 2 -name .git -not -path "$dir/.git/*" -not -path '*/.venv/*' -prune 2>/dev/null)
}

commit_repo() {   # $1 = repo dir
  local dir=$1
  git -C "$dir" remote get-url origin >/dev/null 2>&1 || return 0
  exclude_nested "$dir"
  git -C "$dir" add -A || { fail=1; return; }
  if ! git -C "$dir" diff --cached --quiet; then
    git -C "$dir" commit -q -m "$msg" || { echo "commit failed: $dir"; fail=1; return; }
    echo "committed: ${dir#"$root"/}"
  fi
}

push_repo() {   # $1 = repo dir; first rebases onto what another machine pushed (undone if it conflicts)
  local dir=$1 branch
  git -C "$dir" remote get-url origin >/dev/null 2>&1 || return 0
  branch=$(git -C "$dir" symbolic-ref --short HEAD) || return 0
  git -C "$dir" rev-parse -q --verify HEAD >/dev/null || return 0      # nothing committed yet
  if git -C "$dir" fetch -q origin "$branch" 2>/dev/null && ! git -C "$dir" merge-base --is-ancestor "refs/remotes/origin/$branch" HEAD; then
    git -C "$dir" rebase -q --autostash "refs/remotes/origin/$branch" >/dev/null 2>&1 ||
      { git -C "$dir" rebase --abort 2>/dev/null; echo "conflict with the remote, not pushed: $dir"; fail=1; return; }
    echo "pulled: ${dir#"$root"/}"
  fi
  if [ -z "$(git -C "$dir" ls-remote --heads origin "$branch" 2>/dev/null)" ] ||
     [ -n "$(git -C "$dir" log --oneline "origin/$branch..HEAD" 2>/dev/null | head -1)" ]; then
    git -C "$dir" push -q -u origin "$branch" && echo "pushed: ${dir#"$root"/}" || { echo "push failed: $dir"; fail=1; }
  fi
}

# the workspace and every nested repo, except the cockpit (it syncs itself) and tmp/
repos=("$root")
while IFS= read -r gitdir; do repos+=("${gitdir%/.git}"); done \
  < <(find "$root" -mindepth 2 -name .git -not -path "$root/.git/*" -not -path '*/.venv/*' -not -path "$root/tmp/*" \
        -not -path "$root/cockpit/*" -prune 2>/dev/null)
for r in "${repos[@]}"; do commit_repo "$r"; done
for r in "${repos[@]}"; do push_repo "$r"; done
exit $fail
