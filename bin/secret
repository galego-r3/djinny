#!/usr/bin/env bash
# Short form of secret-tool (keyring: KWallet / GNOME Keyring via libsecret). Symlinked into ~/.local/bin.
#   secret set <service> [attr value]...   store: prompts for the secret (hidden), label = the attributes
#   secret get <service> [attr value]...   print it (what scripts do with `secret-tool lookup service …`)
#   secret del <service> [attr value]...   remove it
#   secret push                            copy every keyring secret into the 1Password vault
#   secret pull                            copy every secret in the 1Password vault into the keyring
# Stored exactly like `secret-tool store --label=… service <service> [attr value]…`, so existing lookups work.
# With "vault" in cockpit.json and the 1Password CLI (`op`) installed, set/del also update that vault
# (one Password item per secret, titled like the label, tag "keyring", attributes in its "keyring" field),
# and get falls back to it. Scripts and jobs keep reading the keyring, so they run without 1Password.
# A service account token for the vault (`secret set op-service-account vault <vault>`, keyring only, never
# pushed) lets op work without unlocking 1Password. Sessions ask the user to run e.g. `! secret set aligulac` (rules C6).
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/../lib/env.sh"
usage() { sed -n '3,7s/^# //p' "$0" >&2; exit 2; }
command -v secret-tool >/dev/null || { echo "secret-tool missing: sudo apt install libsecret-tools" >&2; exit 1; }
vault=$(jq -r '.vault // empty' "$conf" 2>/dev/null || true)
use_op() { [ -n "$vault" ] && command -v op >/dev/null; }
# A 1Password service account for the vault (token in the keyring) means op never asks to unlock;
# without one, op uses the desktop app integration as before
if [ -n "$vault" ] && token=$(secret-tool lookup service op-service-account vault "$vault" 2>/dev/null); then
  export OP_SERVICE_ACCOUNT_TOKEN=$token
  # a token that can't see the vault (e.g. a service account without access) would break op: use the app instead
  op vault get "$vault" >/dev/null 2>&1 || unset OP_SERVICE_ACCOUNT_TOKEN
fi

# 1Password item: written from a JSON template in a private tmpfs folder (never on argv, never on disk)
op_put() {   # $1 = value, rest = service attr value…
  local value=$1; shift
  local title="$1${2:+ (${*:2})}" dir id
  dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/dev/shm}/secret.XXXXXX"); chmod 700 "$dir"
  trap 'rm -rf "$dir"' RETURN
  jq -n --arg t "$title" --arg v "$value" --argjson k "$(jq -nc '$ARGS.positional' --args service "$@")" \
    '{title: $t, category: "PASSWORD", tags: ["keyring"], fields: [
       {id: "password", type: "CONCEALED", purpose: "PASSWORD", label: "password", value: $v},
       {id: "keyring", type: "STRING", label: "keyring", value: ($k | tojson)}]}' > "$dir/item.json"
  id=$(op item get "$title" --vault "$vault" --format json 2>/dev/null | jq -r '.id // empty' || true)
  [ -n "$id" ] && op item delete "$id" --vault "$vault" --archive >/dev/null
  op item create --vault "$vault" --template "$dir/item.json" >/dev/null
}
op_get() {   # JSON, not the plain output: that CSV-quotes values with newlines or quotes
  op item get "$1${2:+ (${*:2})}" --vault "$vault" --fields password --reveal --format json 2>/dev/null | jq -er .value
}

cmd=${1:-}; shift || true
case "$cmd" in
  push|pull) [ $# -eq 0 ] || usage
    use_op || { echo "needs \"vault\" in $conf and the 1Password CLI (op)" >&2; exit 1; }
    op vault get "$vault" >/dev/null || { echo "1Password vault \"$vault\" not found (or op not signed in)" >&2; exit 1; } ;;
  set|get|del) [ $# -ge 1 ] && [ $(( ($# - 1) % 2 )) -eq 0 ] || usage
    service=$1; shift ;;
  *) usage ;;
esac

case "$cmd" in
  set)
    read -rsp "Secret for $service${*:+ $*}: " value; echo >&2
    printf '%s' "$value" | secret-tool store --label="$service${*:+ ($*)}" service "$service" "$@"
    echo "stored: $service${*:+ $*}"
    if use_op; then
      op_put "$value" "$service" "$@" && echo "and in 1Password ($vault)" \
        || echo "not in 1Password yet (op not signed in?): run \`secret push\` later" >&2
    fi ;;
  get)
    secret-tool lookup service "$service" "$@" && exit
    use_op || exit 1
    value=$(op_get "$service" "$@") || exit 1     # not in the keyring: take it from 1Password and keep it
    printf '%s' "$value" | secret-tool store --label="$service${*:+ ($*)}" service "$service" "$@"
    printf '%s\n' "$value" ;;
  del)
    secret-tool clear service "$service" "$@" && echo "removed: $service${*:+ $*}"
    if use_op && id=$(op item get "$service${*:+ ($*)}" --vault "$vault" --format json 2>/dev/null | jq -r .id); then
      op item delete "$id" --vault "$vault" --archive && echo "and archived in 1Password ($vault)"
    fi ;;
  push)   # every keyring entry with a "service" attribute (made by `secret set` / secret-tool)
    n=0
    for item in $(busctl --user --json=short call org.freedesktop.secrets /org/freedesktop/secrets \
                    org.freedesktop.Secret.Service SearchItems a{ss} 0 | jq -r '.data[0][]'); do
      mapfile -t k < <(busctl --user --json=short get-property org.freedesktop.secrets "$item" \
        org.freedesktop.Secret.Item Attributes | jq -r '.data | select(.service) | del(.["xdg:schema"])
          | ["service", .service] + (del(.service) | to_entries | map(.key, .value) | flatten) | .[]')
      [ ${#k[@]} -ge 2 ] && [ "${k[1]}" != op-service-account ] || continue   # the token stays out of the vault
      value=$(secret-tool lookup "${k[@]}") || continue
      op_put "$value" "${k[@]:1}" && n=$((n + 1)) && echo "pushed: ${k[*]:1}"
    done
    echo "$n secrets in 1Password ($vault)" ;;
  pull)
    n=0
    for id in $(op item list --vault "$vault" --tags keyring --format json | jq -r '.[].id'); do
      item=$(op item get "$id" --vault "$vault" --reveal --format json)
      mapfile -t k < <(jq -r '.fields[] | select(.label == "keyring") | .value | fromjson[]' <<<"$item")
      [ ${#k[@]} -ge 2 ] && [ "${k[0]}" = service ] || continue
      jq -j '.fields[] | select(.id == "password") | .value' <<<"$item" \
        | secret-tool store --label="${k[1]}${k[2]:+ (${k[*]:2})}" "${k[@]}"
      n=$((n + 1)); echo "pulled: ${k[*]:1}"
    done
    echo "$n secrets in the keyring" ;;
esac
