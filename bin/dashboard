#!/usr/bin/env -S python3 -I
"""Workspace dashboard, runs full-screen until you quit (q or Ctrl+C). Start it with `dashboard`
(symlinked into ~/.local/bin by install.sh).

Four tabs (Tab key or click): Active, Archive (projects whose Status: line starts with "archived"),
To-dos (the to-do file from cockpit.json "todo_file" plus chores due within 7 days; click ☐ to tick an item)
and Commands (the cockpit's commands with the usage lines from their headers, plus cockpit.json "commands":
{"command": "what it does"}). Scroll with the wheel or ↑/↓/PgUp/PgDn when a tab doesn't fit.
One row per project: colour, live state, status line, last tool call of a running session, tokens used in the
current 5h window, the current
7d window and all time.
- Project = folder with a CLAUDE.md and no project below it (parent folders don't count); the root's row
  has the workspace's name. Rows go at most cockpit.json "depth" (default 2) levels deep: a project deeper
  down (e.g. a worktree in code/wba/wba-31) is counted toward its ancestor at that depth (code/wba). Folders in cockpit.json "hidden" and archived projects (Status: archived …)
  are skipped.
- Live state = busy / question / monitoring, written by hooks/session-state.sh. A project with no session here
  but one on another machine shows "@<host>" in that session's state colour (dim when idle; lib/presence).
- Status = the "Status:" line under the title of the project's CLAUDE.md.
- Colours = "colors" in the workspace's cockpit.json.
- Tokens = input + cache writes + output from the transcripts in ~/.claude/projects (cache reads excluded).
- Click a project name: switches to its Konsole tab, or opens a new tab there running `claude` (`claude
  --resume <id>` when the row has a saved question whose session isn't running and is on this machine).
- Questions are saved apart from the sessions, in <workspace>/.cockpit/questions/ (versioned with the
  workspace): the row keeps its ❓ across restarts and machines until the user writes in that project again
  or dismisses it.
- Dismiss: rows waiting with a question get a number; pressing it deletes their saved questions and marks
  sessions waiting at a dialog idle (no tokens used).
`dashboard --once` prints a single frame and exits.
"""
import calendar, datetime, json, os, re, select, shutil, signal, subprocess, sys, termios, time, tty
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))   # python3 -I: no automatic script dir
import todos

HOME = Path.home()
def workspace():
    """Workspace root: $CLAUDE_WORKSPACE, else ~/.config/claude-cockpit/workspace (written by install.sh), else ~/claude."""
    p = os.environ.get("CLAUDE_WORKSPACE", "")
    if not p:
        try: p = (Path.home() / ".config/claude-cockpit/workspace").read_text().strip()
        except OSError: pass
    return Path(p or "~/claude").expanduser()

def load_conf():
    try: return json.loads((ROOT / "cockpit.json").read_text())
    except (OSError, ValueError): return {}

ROOT = workspace()
CONF = load_conf()
NAME = CONF.get("name") or ROOT.name                 # row, session and tab name of the root itself
OLD_ROOTS = [Path(p).expanduser() for p in CONF.get("old_roots", [])]   # where the workspace lived before
ALIASES = CONF.get("aliases", {})                    # renamed folders (old name -> new name)
SKIP_DIRS = {".git", ".venv", "node_modules"}
HIDDEN = set(CONF.get("hidden", []))                 # folder paths relative to ROOT
DEPTH = int(CONF.get("depth", 2))                    # deepest row: group/project; deeper folders count toward it
REFRESH = 2                                          # seconds between redraws

STATES = {"question": "#E53935", "busy": "#FFD600", "monitoring": "#42A5F5"}   # priority: first wins
# Counter colours: green / yellow / orange / red from these upper bounds per column (5h, 7d, all)
LEVELS = [(50e3, 200e3, 500e3), (250e3, 1e6, 2.5e6), (500e3, 2e6, 5e6)]
LCOL = ["#66BB6A", "#FFD600", "#FFA726", "#E53935"]
HCOL = ["#4FC3F7", "#BA68C8", "#F06292"]             # one colour per column header

RST, BOLD, DIM = "\x1b[0m", "\x1b[1m", "\x1b[2m"
def rgb(h): return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))
def esc(h, bg=False): return "\x1b[{};2;{};{};{}m".format(48 if bg else 38, *rgb(h))
def cut(s, w): return s if len(s) <= w else s[:w - 1] + "…"

# --- projects, statuses, colours ---------------------------------------------------------------
def status_of(d):
    try:
        for line in (d / "CLAUDE.md").read_text(errors="replace").splitlines()[:8]:
            if line.startswith("Status:"):
                return line[7:].strip()
    except OSError:
        pass
    return "—"

FOLDERS = {}   # folder name of every project found -> its row, for transcripts from before a move
def load_rows():
    found = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        rel = os.path.relpath(dirpath, ROOT)
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")
                             and os.path.normpath(os.path.join(rel, d)) not in HIDDEN)
        if "CLAUDE.md" in filenames and Path(dirpath) != ROOT:
            # Rows go at most DEPTH levels deep: a deeper project (e.g. a worktree in code/wba/wba-31) is
            # shown as its ancestor at that depth (code/wba), which collects its state and tokens
            parts = Path(dirpath).relative_to(ROOT).parts
            found.append("/".join(parts[:DEPTH]))
            FOLDERS[parts[-1]] = "/".join(parts[:DEPTH])
    found = sorted(set(found))
    projects = [p for p in found if not any(q.startswith(p + "/") for q in found)]   # leaves only
    return [(NAME, status_of(ROOT))] + [(p, status_of(ROOT / p)) for p in sorted(projects)]

def is_archived(status): return status.lower().startswith("archived")

VIEWS = ["Active", "Archive", "To-dos", "Commands"]   # projects in work / archived projects / to-dos / commands
VIEW = [0]                      # index of the current tab
TABS = []                       # (start column, end column, view index) of each tab label, for clicks
TICK = {}                       # screen line -> (to-do file line index, item text) in the To-dos tab
SCROLL = [0]                    # first body line shown (project rows, to-dos, commands)

def load_colors():
    return load_conf().get("colors", {})              # re-read every frame: edits show up live

def color_of(rel, colors):
    while True:
        if rel in colors: return colors[rel]
        if "/" not in rel: return None
        rel = rel.rsplit("/", 1)[0]

def row_for(cwd, row_paths):
    for base in [ROOT, *OLD_ROOTS]:
        b = str(base)
        if cwd == b: return NAME
        if cwd.startswith(b + "/"):
            rel = cwd[len(b) + 1:]
            hit = next((r for r in row_paths if rel == r or rel.startswith(r + "/")), None)
            if hit: return hit
            # Folder was renamed or moved (e.g. chess -> fun/chess): match by folder name
            for part in rel.split("/"):
                part = ALIASES.get(part, part)
                hit = next((r for r in row_paths if r.rsplit("/", 1)[-1] == part), None) or FOLDERS.get(part)
                if hit in row_paths: return hit
            if rel.split("/")[0] in HIDDEN: return NAME   # e.g. the cockpit itself: shown as the root
            return None                              # folder no longer exists: not shown
    return None

# --- token usage (transcripts are re-read only when they change) ------------------------------
_files = {}   # path -> (mtime, size, {msg_id: (cwd, ts, tokens)})
def transcript_entries():
    seen = set()
    for f in (HOME / ".claude/projects").rglob("*.jsonl"):
        try:
            st = f.stat()
        except OSError:
            continue
        cached = _files.get(f)
        if not cached or cached[:2] != (st.st_mtime, st.st_size):
            entries = {}
            try:
                with f.open(errors="replace") as fh:
                    for line in fh:
                        if '"usage"' not in line:
                            continue
                        try:
                            e = json.loads(line)
                            msg = e.get("message") or {}
                            u = msg.get("usage")
                            if not u or not e.get("cwd"): continue
                            key = msg.get("id") or e.get("requestId") or e.get("uuid")
                            ts = calendar.timegm(time.strptime(e["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
                            n = ((u.get("input_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0)
                                 + (u.get("output_tokens") or 0))
                            entries[key] = (e["cwd"], ts, n)   # one API response is logged once per content block
                        except (ValueError, KeyError, TypeError, AttributeError):
                            continue
            except OSError:
                continue
            cached = _files[f] = (st.st_mtime, st.st_size, entries)
        for key, entry in cached[2].items():
            if key not in seen:
                seen.add(key)
                yield entry

def rate_windows(now):
    windows = {"5h": now - 5 * 3600, "7d": now - 7 * 86400}
    limits = {}
    try:
        rl = json.loads((HOME / ".cache/claude/rate-limits.json").read_text())
        for key, label, span in (("five_hour", "5h", 5 * 3600), ("seven_day", "7d", 7 * 86400)):
            w = rl.get(key) or {}
            reset = float(w.get("resets_at") or 0)
            if reset > now:   # cached window still running: count from its start
                windows[label] = reset - span
                limits[label] = (w.get("used_percentage"), reset)
    except (OSError, ValueError, TypeError):
        pass
    return windows, limits

def alive(pid):
    try: return (Path(f"/proc/{pid}/comm")).read_text().strip() == "claude"   # not a reused PID after a reboot
    except OSError: return False

def tail_lines(path, size=262144):
    """The last complete lines of a file (transcripts get big, only the end is read)."""
    try:
        with path.open("rb") as fh:
            fh.seek(0, 2); end = fh.tell(); fh.seek(max(0, end - size))
            lines = fh.read().decode(errors="replace").splitlines()
        return lines[1:] if end > size else lines
    except OSError:
        return []

def short_path(p, cwd):
    p = str(p or "")
    if cwd and p.startswith(cwd + "/"): return p[len(cwd) + 1:]
    return "~" + p[len(str(HOME)):] if p.startswith(str(HOME) + "/") else p

def first_line(s):
    return next((l.strip() for l in str(s or "").splitlines() if l.strip()), "")

def action(name, i, cwd):
    """What a tool call did, e.g. "bash: git push", "edit: lib.php" — only what Claude wrote, never prompt text."""
    f = short_path(i.get("file_path") or i.get("notebook_path") or i.get("path"), cwd)
    if name == "Bash":
        c = re.sub(r"^(cd [^&;|]+(&&|;) *)+", "", first_line(i.get("command")))
        if (len(c) > 70 or "\n" in str(i.get("command", ""))) and i.get("description"): c = i["description"]
        return ("bash (background)" if i.get("run_in_background") else "bash") + ": " + c
    if name == "SendMessage": return f"message → {i.get('to', '?')}: {first_line(i.get('summary') or i.get('message'))}"
    if name in ("Edit", "Write", "Read", "NotebookEdit"): return f"{name.lower()}: {f}"
    if name == "Agent": return f"agent: {first_line(i.get('description'))}"
    if name == "Skill": return f"skill: {i.get('skill', '?')} {first_line(i.get('args'))}".rstrip()
    if name == "AskUserQuestion": return "question: " + first_line((i.get("questions") or [{}])[0].get("question"))
    if name == "ExitPlanMode": return "plan: ready for approval"
    if name in ("Grep", "Glob"): return f"search: {i.get('pattern', '')}" + (f" in {f}" if f else "")
    if name == "WebSearch": return f"web search: {i.get('query', '')}"
    if name == "WebFetch": return f"fetch: {i.get('url', '')}"
    if name == "ScheduleWakeup": return f"sleep: {i.get('reason', '')}"
    if name.startswith("mcp__"): return "mcp: " + name[5:].replace("__", " ", 1)
    return name.lower() + (f": {f}" if f else f": {first_line(i['description'])}" if i.get("description") else "")

_actions = {}   # transcript -> (mtime, size, last action)
def last_action(sid, cwd):
    """The session's last tool call, from the tail of its transcript."""
    path = HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd) / f"{sid}.jsonl"
    try: st = path.stat()
    except OSError: return ""
    cached = _actions.get(path)
    if cached and cached[:2] == (st.st_mtime, st.st_size): return cached[2]
    act = ""
    for line in reversed(tail_lines(path)):
        if '"tool_use"' not in line: continue
        try:
            e = json.loads(line)
            calls = [c for c in (e.get("message") or {}).get("content") or [] if c.get("type") == "tool_use"]
            if calls: act = action(calls[-1].get("name", ""), calls[-1].get("input") or {}, cwd); break
        except (ValueError, AttributeError, TypeError):
            continue
    _actions[path] = (st.st_mtime, st.st_size, act)
    return act

REGISTRY = {"busy": "busy", "shell": "monitoring", "waiting": "question"}   # Claude Code's own session states
QDIR = ROOT / ".cockpit/questions"   # saved questions, one file per session (hooks/session-state.sh)
ORPHANS = {}   # row -> session id of a saved question whose session isn't running, refreshed every frame
ACTIONS = {}   # row -> last tool call of its most recently active running session, refreshed every frame
ASKING = {}    # row -> pids of its running sessions with a question, so a click goes to the right tab
def live_states(row_paths):
    """Row -> set of live states, and row -> dismiss actions: saved question files plus live state files
    waiting at a permission/question dialog. Sessions without a state file (started before the hooks were
    installed) fall back to Claude Code's own registry in ~/.claude/sessions/<pid>.json."""
    live, files = {}, {}
    ORPHANS.clear(); ACTIONS.clear(); ASKING.clear()
    pids = {}              # session id -> pid of its running Claude process
    running = set()        # rows with a running session
    hooked = set()         # pids with a state file from the hook
    for f in (HOME / ".cache/claude/sessions").glob("*.json"):
        try:
            st = json.loads(f.read_text())
            if not alive(st["pid"]):
                f.unlink(); continue                 # that Claude process is gone
            hooked.add(st["pid"]); pids[f.stem] = st["pid"]
            row = row_for(st["cwd"], row_paths)
            if not row: continue
            running.add(row)
            state = {"input": "question"}.get(st["state"], st["state"])
            live.setdefault(row, set()).add(state)
            if state == "question":
                files.setdefault(row, []).append(f); ASKING.setdefault(row, set()).add(st["pid"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
    newest = {}            # row -> updatedAt of the session its action comes from
    for f in (HOME / ".claude/sessions").glob("*.json"):
        try:
            st = json.loads(f.read_text())
            if st.get("kind", "interactive") != "interactive" or not alive(st["pid"]): continue
            row = row_for(st["cwd"], row_paths)
            if not row: continue
            running.add(row)
            if st["pid"] not in hooked and st.get("status") in REGISTRY and st.get("waitingFor") != "dialog open":
                live.setdefault(row, set()).add(REGISTRY[st["status"]])
            if st.get("updatedAt", 0) >= newest.get(row, -1):
                newest[row] = st.get("updatedAt", 0)
                ACTIONS[row] = last_action(st.get("sessionId", ""), st["cwd"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
    for f in sorted(QDIR.glob("*.json"), key=lambda f: f.stat().st_mtime, reverse=True):
        try:
            q = json.loads(f.read_text())
            row = row_for(str(ROOT if q["project"] == "." else ROOT / q["project"]), row_paths)
            if not row: continue
            live.setdefault(row, set()).add("question")
            files.setdefault(row, []).append(f)
            if q.get("session") in pids: ASKING.setdefault(row, set()).add(pids[q["session"]])
            if transcript(q.get("session", "")): ORPHANS.setdefault(row, q["session"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
    for row in running: ORPHANS.pop(row, None)
    return live, files

PRESENCE = Path(__file__).resolve().parent.parent / "lib/presence"
_remote = {"fetch": None, "fetched": 0, "read": 0, "data": {}}
def remote_states(row_paths):
    """Row -> (state, host) of sessions on other machines (lib/presence): fetched in the background every
    minute, read every 30 s and right after a fetch."""
    now, r = time.time(), _remote
    if r["fetch"] and r["fetch"].poll() is not None: r["fetch"], r["read"] = None, 0
    if not r["fetch"] and now - r["fetched"] >= 60:
        r["fetched"] = now
        r["fetch"] = subprocess.Popen([PRESENCE, "fetch"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                      stderr=subprocess.DEVNULL, start_new_session=True)
    if now - r["read"] >= 30:
        r["read"] = now
        try: r["data"] = json.loads(subprocess.run([PRESENCE, "show"], capture_output=True, text=True,
                                                   timeout=10).stdout or "{}")
        except (OSError, ValueError, subprocess.TimeoutExpired): pass
    out = {}
    order = list(STATES) + ["idle"]
    for host, m in r["data"].items():
        for st in m.get("sessions", []):
            try:
                row = row_for(str(ROOT if st["project"] == NAME else ROOT / st["project"]), row_paths)
                state = st["state"] if st["state"] in order else "idle"
            except (KeyError, TypeError): continue
            if row and (row not in out or order.index(state) < order.index(out[row][0])):
                out[row] = (state, host)
    return out

def transcript(sid):
    """True when this machine has the session's transcript, so `claude --resume` can open it."""
    return bool(sid) and any((HOME / ".claude/projects").glob(f"*/{sid}.jsonl"))

DISMISS = {}   # key -> question files of that row, refreshed every frame
CLICK = {}     # screen line (0-based) -> project row, refreshed every frame
def dismiss(key):
    for f in DISMISS.get(key, []):
        try:
            if f.parent == QDIR: f.unlink(); continue
            st = json.loads(f.read_text())
            if st.get("state") in ("question", "input"):
                st["state"] = "idle"
                f.with_suffix(".tmp").write_text(json.dumps(st)); f.with_suffix(".tmp").replace(f)
        except (OSError, ValueError):
            pass

# --- one frame ---------------------------------------------------------------------------------
def human(n):
    if n == 0: return "·"
    if n >= 1e6: return f"{n / 1e6:.1f}M"
    if n >= 1e3: return f"{n / 1e3:.0f}k"
    return str(n)

def heat(n, col):
    return DIM if n == 0 else esc(LCOL[sum(n >= t for t in LEVELS[col])])

def fmt_reset(ts):
    t = time.localtime(ts)
    return time.strftime("%H:%M" if time.strftime("%F", t) == time.strftime("%F") else "%a %H:%M", t)

def header(limits, n_arch, n_todo):
    head = f"{BOLD}{esc('#7EC8F7')}▌ {NAME} workspace{RST} {DIM}{time.strftime('%Y-%m-%d %H:%M:%S')}"
    for label in ("5h", "7d"):
        if label in limits:
            pct, reset = limits[label]
            head += f"  {label} {pct:.0f}% ↻ {fmt_reset(reset)}" if pct is not None else f"  {label} ↻ {fmt_reset(reset)}"
        else:
            head += f"  {label} rolling"
    # Tab bar: filled buttons, the current tab in the header colour, the others grey
    bar, col_ = " ", 2
    TABS.clear()
    for i, name in enumerate(VIEWS):
        n = (None, n_arch, n_todo, None)[i]
        label = f" {name} ({n}) " if n is not None else f" {name} "
        TABS.append((col_, col_ + len(label) - 1, i))
        bar += (f"{BOLD}{esc('#7EC8F7', bg=True)}{esc('#101820')}{label}{RST}" if i == VIEW[0]
                else f"{esc('#3A3F47', bg=True)}{esc('#C8CCD2')}{label}{RST}") + " "
        col_ += len(label) + 1
    return [head + RST, bar]

def todo_frame(head, W, H, colors):
    """The To-dos tab: pinned lines, agent questions, chores due soon, open items per section."""
    path = todos.todo_file(ROOT, CONF)
    body = []                                         # (line, tick payload or None)
    if not path:
        body.append((f"  {DIM}no \"todo_file\" in cockpit.json{RST}", None))
    else:
        try: intro = path.read_text().split("\n## ", 1)[0].splitlines()
        except OSError: intro = []
        for line in intro:
            if any(line.startswith(p) for p in CONF.get("todo_pinned", [])):
                body.append((f"  {BOLD}{line.replace('**', '')}{RST}", None))
        today = datetime.date.today()
        soon = [c for c in todos.chores(ROOT, HIDDEN) if c[0] <= (today + datetime.timedelta(days=7)).isoformat()]
        if soon:
            body += [("", None), (f"{BOLD}{esc(STATES['monitoring'])}▌ Chores due{RST}", None)]
            for due, proj, chore, _last in soon:
                d = (datetime.date.fromisoformat(due) - today).days
                when = "today" if d == 0 else f"{-d}d overdue" if d < 0 else f"in {d}d"
                col = esc(STATES["question"]) if d < 0 else ""
                body.append((f"    {col}{due} {when:<11}{RST} {cut(chore, W - 50)}  {DIM}{proj}{RST}", None))
        sec = None
        for s, i, text in todos.open_items(path):
            if s != sec:
                sec = s
                key = todos.section_project(s)
                col = (STATES["question"] if key in ("Priority", "Questions from agents")
                       else color_of(NAME if key.startswith(NAME) else key, colors))
                body += [("", None), (f"{BOLD}{esc(col) if col else ''}▌ {s}{RST}", None)]
            body.append((f"    ☐ {cut(todos.plain(text), W - 8)}", (i, text)))
    room = max(1, H - len(head) - 2)
    SCROLL[0] = max(0, min(SCROLL[0], len(body) - room))
    shown = body[SCROLL[0]:SCROLL[0] + room]
    out = head + [""]
    TICK.clear()
    for line, payload in shown:
        if payload: TICK[len(out)] = payload
        out.append(line)
    more = f"lines {SCROLL[0] + 1}–{SCROLL[0] + len(shown)} of {len(body)}, ↑/↓/wheel scroll · " if len(body) > room else ""
    out.append(f"{DIM}{more}q to quit · Tab switches tabs · click ☐ to tick an item{RST}")
    return out

def usage_lines(path):
    """(command, what it does) from a script's header: lines starting with its name, then 2+ spaces and the
    description; indented lines without the name continue the description."""
    out = []
    try: head = path.read_text().splitlines()[:25]
    except (OSError, UnicodeDecodeError): return out
    for line in head:
        line = line.lstrip("#").rstrip()
        m = re.match(rf"\s+({re.escape(path.name)}\b.*?)\s{{2,}}(\S.*)$", line)
        if m: out.append([m[1], m[2]])
        elif out and line.startswith("  ") and line.strip() and not line.strip().startswith(path.name):
            if len(line) - len(line.lstrip()) > 8: out[-1][1] += " " + line.strip()
            else: break
        elif out and not line.strip(): break
    return out

def commands_frame(head, W, H):
    """The Commands tab: the cockpit's own commands (bin/) and the workspace's from cockpit.json "commands"."""
    body = [f"{BOLD}{esc('#7EC8F7')}▌ Cockpit{RST}"]
    for f in sorted((Path(__file__).resolve().parent).iterdir()):
        if f.name == "dashboard": cmds = [["dashboard", "this view (dashboard --once prints one frame)"]]
        else: cmds = usage_lines(f)
        cw = max((len(c) for c, _ in cmds), default=0)
        for c, d in cmds:
            body.append(f"    {BOLD}{c:<{cw}}{RST}  {DIM}{cut(d, max(10, W - cw - 8))}{RST}")
        if cmds: body.append("")
    extra = CONF.get("commands", {})
    if extra:
        body.append(f"{BOLD}{esc('#7EC8F7')}▌ {NAME}{RST}")
        cw = max(len(c) for c in extra)
        for c, d in extra.items():
            body.append(f"    {BOLD}{c:<{cw}}{RST}  {DIM}{cut(d, max(10, W - cw - 8))}{RST}")
        body.append("")
    body.append(f"{DIM}In a Claude session, start a line with ! to run a command there (e.g. ! secret set <service>).{RST}")
    room = max(1, H - len(head) - 2)
    SCROLL[0] = max(0, min(SCROLL[0], len(body) - room))
    shown = body[SCROLL[0]:SCROLL[0] + room]
    more = f"lines {SCROLL[0] + 1}–{SCROLL[0] + len(shown)} of {len(body)}, ↑/↓/wheel scroll · " if len(body) > room else ""
    return head + [""] + shown + [f"{DIM}{more}q to quit · Tab switches tabs{RST}"]

def frame():
    now = time.time()
    all_rows, colors = load_rows(), load_colors()
    tpath = todos.todo_file(ROOT, CONF)
    n_todo = len(todos.open_items(tpath)) if tpath else 0
    row_paths = sorted((r for r, _ in all_rows if r != NAME), key=len, reverse=True)   # usage counts for all
    n_arch = sum(is_archived(st) for _, st in all_rows)
    rows = [(r, st) for r, st in all_rows if is_archived(st) == (VIEW[0] == 1)]
    windows, limits = rate_windows(now)
    if VIEW[0] >= 2:
        W, H = shutil.get_terminal_size((120, 40))
        if VIEW[0] == 3: return commands_frame(header(limits, n_arch, n_todo), W, H)
        return todo_frame(header(limits, n_arch, n_todo), W, H, colors)
    usage = {}
    for cwd, ts, n in transcript_entries():
        row = row_for(cwd, row_paths)
        if row is None: continue
        c = usage.setdefault(row, [0, 0, 0])
        if ts >= windows["5h"]: c[0] += n
        if ts >= windows["7d"]: c[1] += n
        c[2] += n
    live, qfiles = live_states(row_paths)
    remote = remote_states(row_paths)
    DISMISS.clear(); CLICK.clear()

    W, H = shutil.get_terminal_size((120, 40))
    NUMW, STATEW = 6, 12                 # state column fits "monitoring" plus a gap
    namew = min(28, max(len(r) for r, _ in rows))
    fixed = 3 + namew + 2 + STATEW + 2 + 3 * NUMW + 2
    # Last tool call of running sessions, in its own column when the terminal has room for it
    actw = min(48, W - fixed - 12 - 3) if any(ACTIONS.get(r) for r, _ in rows) else 0
    actw = actw if actw >= 20 else 0
    actcol = actw + 2 if actw else 0
    statw = max(12, min(max(len(s) for _, s in rows), W - fixed - 1 - actcol))

    out = header(limits, n_arch, n_todo)
    pad = " " * (3 + namew + 2 + STATEW + statw + 2 + actcol)
    out.append(pad + " ".join(f"{BOLD}{esc(c)}{t:>{NUMW}}{RST}" for t, c in zip(("5h", "7d", "all"), HCOL)))

    # Each row gets a line of "▔" below it: a thin border in the row's colour (top eighth of the
    # cell, ~3px) with empty space under it
    rule_w = 3 + namew + 2 + STATEW + statw + 2 + actcol + 3 * NUMW + 2
    tot, body, at = [0, 0, 0], [], {}               # at: body line -> project, for clicks
    for rel, st in rows:
        at[len(body)] = at[len(body) + 1] = rel
        col = color_of(rel, colors)
        sw = f"{esc(col, bg=True)}  {RST}" if col else f"{DIM}░░{RST}"
        state = next((s for s in STATES if s in live.get(rel, ())), "")
        label, width = state, len(state)
        lcol = esc(STATES[state]) if state else ""
        if not state and rel in remote:              # only running on another machine
            rstate, host = remote[rel]
            label = cut(f"@{host}", STATEW - 1); width = len(label)
            lcol = esc(STATES[rstate]) if rstate in STATES else DIM
        if state == "question":                      # shown as "❓" (2 columns wide), with its dismiss key
            label, width = "❓", 2
            if len(DISMISS) < 9:
                key = str(len(DISMISS) + 1)
                DISMISS[key] = qfiles.get(rel, [])
                label, width = f"❓ key {key}", 8      # the dismiss key, not a count
        u = usage.get(rel, [0, 0, 0])
        tot = [a + b for a, b in zip(tot, u)]
        nums = " ".join(f"{heat(n, i)}{human(n):>{NUMW}}{RST}" for i, n in enumerate(u))
        act = f"{DIM}{cut(ACTIONS.get(rel, ''), actw):<{actw}}{RST}  " if actw else ""
        body.append(f"{sw} {cut(rel, namew):<{namew}}  "
                   f"{BOLD}{lcol}{label}{' ' * (STATEW - width)}{RST}"
                   f"{cut(st, statw):<{statw}}  {act}{nums}")
        body.append((esc(col) if col else DIM) + "▔" * rule_w + RST)
    room = max(2, H - len(out) - 2)                 # the rows scroll; header, total and help line stay
    SCROLL[0] = max(0, min(SCROLL[0], len(body) - room))
    for i, line in enumerate(body[SCROLL[0]:SCROLL[0] + room]):
        if SCROLL[0] + i in at: CLICK[len(out)] = at[SCROLL[0] + i]
        out.append(line)
    more = f"rows {SCROLL[0] // 2 + 1}–{min(len(rows), (SCROLL[0] + room) // 2)} of {len(rows)}, ↑/↓/wheel scroll · " if len(body) > room else ""
    nums = " ".join(f"{human(n):>{NUMW}}" for n in tot)
    out.append(f"   {BOLD}{'total':<{namew}}{RST}  {'':<{STATEW}}"
               f"{DIM}{cut('tokens = input + cache writes + output', statw):<{statw}}{RST}  {' ' * actcol}{BOLD}{nums}{RST}")
    out.append(f"{DIM}{more}q to quit · Tab switches tabs · click a name to go to its tab · 1-9 dismisses that ❓ · refreshes every {REFRESH}s{RST}")
    return out

# --- main loop ---------------------------------------------------------------------------------
TAB_TITLE, TAB_COLOR = "DASH", "#FF0096"     # the dashboard's own Konsole tab name and colour
def konsole_tab(*calls):
    svc, sess = os.environ.get("KONSOLE_DBUS_SERVICE"), os.environ.get("KONSOLE_DBUS_SESSION")
    if not (svc and sess): return
    for call in calls:
        subprocess.run(["qdbus6", svc, sess, *call], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def qdbus(*args):
    r = subprocess.run(["qdbus6", os.environ.get("KONSOLE_DBUS_SERVICE", ""), *args],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None

def goto_project(rel):
    """Switch to the project's tab (title set by session-name.sh) or open one running claude, resuming
    the session of a saved question."""
    win = os.environ.get("KONSOLE_DBUS_WINDOW")
    if not (win and os.environ.get("KONSOLE_DBUS_SERVICE")): return
    tabs = [sid for sid in (qdbus(win, "sessionList") or "").split()
            if qdbus(f"/Sessions/{sid}", "tabTitleFormat", "0") == rel]
    if tabs:   # several tabs for one project: prefer the one whose Claude is asking
        asking = {str(p) for p in ASKING.get(rel, ())}
        qdbus(win, "setCurrentSession", next((sid for sid in tabs if asking & children(qdbus(f"/Sessions/{sid}", "processId"))), tabs[0]))
        return
    # Konsole's D-Bus can't run commands in a tab: the new shell starts claude when it finds its folder
    # in this marker, plus the session to resume on a second line (shell/bashrc.sh)
    cwd = str(ROOT if rel == NAME else ROOT / rel)
    (HOME / ".cache/claude/autostart").write_text(cwd + "\n" + (ORPHANS.get(rel, "") + "\n" if rel in ORPHANS else ""))
    sid = qdbus(win, "newSession", qdbus(win, "defaultProfile") or "", cwd)
    if sid:
        qdbus(win, "setCurrentSession", sid)

def children(pid):
    """Pids of a process's direct children (a tab's shell -> its claude)."""
    try: return set(Path(f"/proc/{pid}/task/{pid}/children").read_text().split())
    except (OSError, TypeError): return set()

MOUSE = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
def handle_input(data):
    """Returns True to quit, False to redraw now, None to keep waiting."""
    if data in ("q", "Q", "\x1b"):
        return True
    redraw = None
    for key, step in (("\x1b[A", -1), ("\x1b[B", 1), ("\x1b[5~", -10), ("\x1b[6~", 10)):   # ↑ ↓ PgUp PgDn
        if key in data:
            SCROLL[0] = max(0, SCROLL[0] + step * data.count(key)); data = data.replace(key, ""); redraw = False
    for b, x, y, kind in MOUSE.findall(data):
        if b in ("64", "65") and kind == "M":                     # mouse wheel
            SCROLL[0] = max(0, SCROLL[0] + (3 if b == "65" else -3)); redraw = False; continue
        if b != "0" or kind != "M": continue                      # left button press only
        if int(y) == 2:                                           # tab bar (second line)
            for start, end, i in TABS:
                if start <= int(x) <= end: VIEW[0] = i; SCROLL[0] = 0; redraw = False
        elif VIEW[0] == 2:
            if int(y) - 1 in TICK and int(x) <= 6:                # the ☐ column
                todos.tick(todos.todo_file(ROOT, CONF), *TICK[int(y) - 1]); redraw = False
        elif int(y) - 1 in CLICK:
            goto_project(CLICK[int(y) - 1]); redraw = False
    rest = MOUSE.sub("", data)
    for ch in rest:
        if ch in ("q", "Q"): return True
        if ch == "\t": VIEW[0] = (VIEW[0] + 1) % len(VIEWS); SCROLL[0] = 0; redraw = False
        if ch in DISMISS: dismiss(ch); redraw = False
    return redraw

def main():
    if "--once" in sys.argv or not sys.stdout.isatty():
        print("\n".join(frame()))
        return
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    resized = []
    signal.signal(signal.SIGWINCH, lambda *_: resized.append(1))
    konsole_tab(("setTabTitleFormat", "0", TAB_TITLE), ("setTabTitleFormat", "1", TAB_TITLE))
    subprocess.run([Path(__file__).resolve().parent.parent / "lib/konsole-color", TAB_COLOR],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen([Path(__file__).resolve().parent.parent / "hooks/sort-tabs.sh"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)   # DASH tab moves to the front
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1006h")   # alternate screen, hide cursor, no line wrap (a wrapped line would shift the click targets below it), mouse clicks
    try:
        tty.setcbreak(fd)
        while True:
            lines = frame()[:shutil.get_terminal_size().lines]
            sys.stdout.write("\x1b[H" + "".join(l + "\x1b[K\n" for l in lines[:-1]) + lines[-1] + "\x1b[K\x1b[J")
            sys.stdout.flush()
            resized.clear()
            deadline = time.time() + REFRESH
            while time.time() < deadline and not resized:
                try:
                    ready, _, _ = select.select([sys.stdin], [], [], max(0, deadline - time.time()))
                except InterruptedError:
                    break                            # window resized: redraw now
                if ready:
                    act = handle_input(os.read(fd, 1024).decode(errors="replace"))
                    if act: return
                    if act is False: break           # redraw now
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        konsole_tab(("setTabTitleFormat", "0", "%d : %n"), ("setTabTitleFormat", "1", "(%u) %H"))   # Konsole defaults
        sys.stdout.write("\x1b[?1006l\x1b[?1000l\x1b[?7h\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()

main()
