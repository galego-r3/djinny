#!/usr/bin/env -S python3 -I
"""Workspace dashboard, runs full-screen until you quit (q or Ctrl+C). Start it with `dashboard`
(symlinked into ~/.local/bin by install.sh).

Two tabs (Tab key or click): Active and Archive (projects whose Status: line starts with "archived").
One row per project: colour, live state, status line, tokens used in the current 5h window, the current
7d window and all time.
- Project = folder with a CLAUDE.md and no project below it (parent folders don't count); the root's row
  has the workspace's name. Folders in cockpit.json "hidden" and archived projects (Status: archived …)
  are skipped.
- Live state = busy / question / monitoring, written by hooks/session-state.sh.
- Status = the "Status:" line under the title of the project's CLAUDE.md.
- Colours = "colors" in the workspace's cockpit.json.
- Tokens = input + cache writes + output from the transcripts in ~/.claude/projects (cache reads excluded).
- Click a project name: switches to its Konsole tab, or opens a new tab there running `claude`.
- Dismiss: rows waiting with a question get a number; pressing it marks those sessions idle (no tokens used).
`dashboard --once` prints a single frame and exits.
"""
import calendar, json, os, re, select, shutil, signal, subprocess, sys, termios, time, tty
from pathlib import Path

HOME = Path.home()
def workspace():
    """Workspace root: $CLAUDE_WORKSPACE, else ~/.config/claude-cockpit/workspace (written by install.sh), else ~/claude."""
    p = os.environ.get("CLAUDE_WORKSPACE", "")
    if not p:
        try: p = (Path.home() / ".config/claude-cockpit/workspace").read_text().strip()
        except OSError: pass
    return Path(p or "~/claude").expanduser()

def load_conf():
    try: return json.loads((ROOT / "cockpit.json").read_text())
    except (OSError, ValueError): return {}

ROOT = workspace()
NAME = ROOT.name                                     # row, session and tab name of the root itself
CONF = load_conf()
OLD_ROOTS = [Path(p).expanduser() for p in CONF.get("old_roots", [])]   # where the workspace lived before
ALIASES = CONF.get("aliases", {})                    # renamed folders (old name -> new name)
SKIP_DIRS = {".git", ".venv", "node_modules"}
HIDDEN = set(CONF.get("hidden", []))                 # folder paths relative to ROOT
REFRESH = 2                                          # seconds between redraws

STATES = {"question": "#E53935", "busy": "#FFD600", "monitoring": "#42A5F5"}   # priority: first wins
# Counter colours: green / yellow / orange / red from these upper bounds per column (5h, 7d, all)
LEVELS = [(50e3, 200e3, 500e3), (250e3, 1e6, 2.5e6), (500e3, 2e6, 5e6)]
LCOL = ["#66BB6A", "#FFD600", "#FFA726", "#E53935"]
HCOL = ["#4FC3F7", "#BA68C8", "#F06292"]             # one colour per column header

RST, BOLD, DIM = "\x1b[0m", "\x1b[1m", "\x1b[2m"
def rgb(h): return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))
def esc(h, bg=False): return "\x1b[{};2;{};{};{}m".format(48 if bg else 38, *rgb(h))
def cut(s, w): return s if len(s) <= w else s[:w - 1] + "…"

# --- projects, statuses, colours ---------------------------------------------------------------
def status_of(d):
    try:
        for line in (d / "CLAUDE.md").read_text(errors="replace").splitlines()[:8]:
            if line.startswith("Status:"):
                return line[7:].strip()
    except OSError:
        pass
    return "—"

def load_rows():
    found = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        rel = os.path.relpath(dirpath, ROOT)
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")
                             and os.path.normpath(os.path.join(rel, d)) not in HIDDEN)
        if "CLAUDE.md" in filenames and Path(dirpath) != ROOT:
            found.append(str(Path(dirpath).relative_to(ROOT)))
    projects = [p for p in found if not any(q.startswith(p + "/") for q in found)]   # leaves only
    return [(NAME, status_of(ROOT))] + [(p, status_of(ROOT / p)) for p in sorted(projects)]

def is_archived(status): return status.lower().startswith("archived")

VIEWS = ["Active", "Archive"]   # dashboard tabs: projects in work / archived projects (RULES.md C1)
VIEW = [0]                      # index of the current tab
TABS = []                       # (start column, end column, view index) of each tab label, for clicks

def load_colors():
    return load_conf().get("colors", {})              # re-read every frame: edits show up live

def color_of(rel, colors):
    while True:
        if rel in colors: return colors[rel]
        if "/" not in rel: return None
        rel = rel.rsplit("/", 1)[0]

def row_for(cwd, row_paths):
    for base in [ROOT, *OLD_ROOTS]:
        b = str(base)
        if cwd == b: return NAME
        if cwd.startswith(b + "/"):
            rel = cwd[len(b) + 1:]
            hit = next((r for r in row_paths if rel == r or rel.startswith(r + "/")), None)
            if hit: return hit
            # Folder was renamed or moved (e.g. chess -> fun/chess): match by folder name
            for part in rel.split("/"):
                part = ALIASES.get(part, part)
                hit = next((r for r in row_paths if r.rsplit("/", 1)[-1] == part), None)
                if hit: return hit
            if rel.split("/")[0] in HIDDEN: return NAME   # e.g. the cockpit itself: shown as the root
            return None                              # folder no longer exists: not shown
    return None

# --- token usage (transcripts are re-read only when they change) ------------------------------
_files = {}   # path -> (mtime, size, {msg_id: (cwd, ts, tokens)})
def transcript_entries():
    seen = set()
    for f in (HOME / ".claude/projects").rglob("*.jsonl"):
        try:
            st = f.stat()
        except OSError:
            continue
        cached = _files.get(f)
        if not cached or cached[:2] != (st.st_mtime, st.st_size):
            entries = {}
            try:
                with f.open(errors="replace") as fh:
                    for line in fh:
                        if '"usage"' not in line:
                            continue
                        try:
                            e = json.loads(line)
                            msg = e.get("message") or {}
                            u = msg.get("usage")
                            if not u or not e.get("cwd"): continue
                            key = msg.get("id") or e.get("requestId") or e.get("uuid")
                            ts = calendar.timegm(time.strptime(e["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
                            n = ((u.get("input_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0)
                                 + (u.get("output_tokens") or 0))
                            entries[key] = (e["cwd"], ts, n)   # one API response is logged once per content block
                        except (ValueError, KeyError, TypeError, AttributeError):
                            continue
            except OSError:
                continue
            cached = _files[f] = (st.st_mtime, st.st_size, entries)
        for key, entry in cached[2].items():
            if key not in seen:
                seen.add(key)
                yield entry

def rate_windows(now):
    windows = {"5h": now - 5 * 3600, "7d": now - 7 * 86400}
    limits = {}
    try:
        rl = json.loads((HOME / ".cache/claude/rate-limits.json").read_text())
        for key, label, span in (("five_hour", "5h", 5 * 3600), ("seven_day", "7d", 7 * 86400)):
            w = rl.get(key) or {}
            reset = float(w.get("resets_at") or 0)
            if reset > now:   # cached window still running: count from its start
                windows[label] = reset - span
                limits[label] = (w.get("used_percentage"), reset)
    except (OSError, ValueError, TypeError):
        pass
    return windows, limits

def live_states(row_paths):
    live, files = {}, {}   # row -> set of states, row -> question state files
    for f in (HOME / ".cache/claude/sessions").glob("*.json"):
        try:
            st = json.loads(f.read_text())
            if not Path(f"/proc/{st['pid']}").exists():
                f.unlink(); continue                 # that Claude process is gone
            row = row_for(st["cwd"], row_paths)
            if not row: continue
            state = {"input": "question"}.get(st["state"], st["state"])
            live.setdefault(row, set()).add(state)
            if state == "question": files.setdefault(row, []).append(f)
        except (OSError, ValueError, KeyError, TypeError):
            continue
    return live, files

DISMISS = {}   # key -> question state files of that row, refreshed every frame
CLICK = {}     # screen line (0-based) -> project row, refreshed every frame
def dismiss(key):
    for f in DISMISS.get(key, []):
        try:
            st = json.loads(f.read_text())
            if st.get("state") in ("question", "input"):
                st["state"] = "idle"
                f.with_suffix(".tmp").write_text(json.dumps(st)); f.with_suffix(".tmp").replace(f)
        except (OSError, ValueError):
            pass

# --- one frame ---------------------------------------------------------------------------------
def human(n):
    if n == 0: return "·"
    if n >= 1e6: return f"{n / 1e6:.1f}M"
    if n >= 1e3: return f"{n / 1e3:.0f}k"
    return str(n)

def heat(n, col):
    return DIM if n == 0 else esc(LCOL[sum(n >= t for t in LEVELS[col])])

def fmt_reset(ts):
    t = time.localtime(ts)
    return time.strftime("%H:%M" if time.strftime("%F", t) == time.strftime("%F") else "%a %H:%M", t)

def frame():
    now = time.time()
    all_rows, colors = load_rows(), load_colors()
    row_paths = sorted((r for r, _ in all_rows if r != NAME), key=len, reverse=True)   # usage counts for all
    n_arch = sum(is_archived(st) for _, st in all_rows)
    rows = [(r, st) for r, st in all_rows if is_archived(st) == (VIEW[0] == 1)]
    windows, limits = rate_windows(now)
    usage = {}
    for cwd, ts, n in transcript_entries():
        row = row_for(cwd, row_paths)
        if row is None: continue
        c = usage.setdefault(row, [0, 0, 0])
        if ts >= windows["5h"]: c[0] += n
        if ts >= windows["7d"]: c[1] += n
        c[2] += n
    live, qfiles = live_states(row_paths)
    DISMISS.clear(); CLICK.clear()

    W, H = shutil.get_terminal_size((120, 40))
    NUMW, STATEW = 6, 12                 # state column fits "monitoring" plus a gap
    namew = min(28, max(len(r) for r, _ in rows))
    fixed = 3 + namew + 2 + STATEW + 2 + 3 * NUMW + 2
    statw = max(12, min(max(len(s) for _, s in rows), W - fixed - 1))

    head = f"{BOLD}{esc('#7EC8F7')}▌ {NAME} workspace{RST} {DIM}{time.strftime('%Y-%m-%d %H:%M:%S')}"
    for label in ("5h", "7d"):
        if label in limits:
            pct, reset = limits[label]
            head += f"  {label} {pct:.0f}% ↻ {fmt_reset(reset)}" if pct is not None else f"  {label} ↻ {fmt_reset(reset)}"
        else:
            head += f"  {label} rolling"
    out = [head + RST]
    # Tab bar: the current tab bold and underlined in the header colour
    bar, col_ = " ", 2
    TABS.clear()
    for i, name in enumerate(VIEWS):
        label = f" {name} ({n_arch}) " if i == 1 else f" {name} "
        TABS.append((col_, col_ + len(label) - 1, i))
        bar += (f"{BOLD}\x1b[4m{esc('#7EC8F7')}{label}{RST}" if i == VIEW[0] else f"{DIM}{label}{RST}") + " "
        col_ += len(label) + 1
    out.append(bar)
    pad = " " * (3 + namew + 2 + STATEW + statw + 2)
    out.append(pad + " ".join(f"{BOLD}{esc(c)}{t:>{NUMW}}{RST}" for t, c in zip(("5h", "7d", "all"), HCOL)))

    # Each row gets a line of "▔" below it: a thin border in the row's colour (top eighth of the
    # cell, ~3px) with empty space under it
    rule_w = 3 + namew + 2 + STATEW + statw + 2 + 3 * NUMW + 2
    tot = [0, 0, 0]
    for rel, st in rows:
        CLICK[len(out)] = CLICK[len(out) + 1] = rel
        col = color_of(rel, colors)
        sw = f"{esc(col, bg=True)}  {RST}" if col else f"{DIM}░░{RST}"
        state = next((s for s in STATES if s in live.get(rel, ())), "")
        label, width = state, len(state)
        if state == "question":                      # shown as "❓" (2 columns wide), with its dismiss key
            label, width = "❓", 2
            if len(DISMISS) < 9:
                key = str(len(DISMISS) + 1)
                DISMISS[key] = qfiles.get(rel, [])
                label, width = f"{key} ❓", 4
        u = usage.get(rel, [0, 0, 0])
        tot = [a + b for a, b in zip(tot, u)]
        nums = " ".join(f"{heat(n, i)}{human(n):>{NUMW}}{RST}" for i, n in enumerate(u))
        out.append(f"{sw} {cut(rel, namew):<{namew}}  "
                   f"{BOLD}{esc(STATES[state]) if state else ''}{label}{' ' * (STATEW - width)}{RST}"
                   f"{cut(st, statw):<{statw}}  {nums}")
        out.append((esc(col) if col else DIM) + "▔" * rule_w + RST)
    nums = " ".join(f"{human(n):>{NUMW}}" for n in tot)
    out.append(f"   {BOLD}{'total':<{namew}}{RST}  {'':<{STATEW}}"
               f"{DIM}{cut('tokens = input + cache writes + output', statw):<{statw}}{RST}  {BOLD}{nums}{RST}")
    out.append(f"{DIM}q to quit · Tab switches Active/Archive · click a name to go to its tab · 1-9 dismisses that ❓ · refreshes every {REFRESH}s{RST}")
    return out

# --- main loop ---------------------------------------------------------------------------------
TAB_TITLE, TAB_COLOR = "DASH", "#FF0096"     # the dashboard's own Konsole tab name and colour
def konsole_tab(*calls):
    svc, sess = os.environ.get("KONSOLE_DBUS_SERVICE"), os.environ.get("KONSOLE_DBUS_SESSION")
    if not (svc and sess): return
    for call in calls:
        subprocess.run(["qdbus6", svc, sess, *call], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def qdbus(*args):
    r = subprocess.run(["qdbus6", os.environ.get("KONSOLE_DBUS_SERVICE", ""), *args],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None

def goto_project(rel):
    """Switch to the project's tab (title set by session-name.sh) or open one running claude."""
    win = os.environ.get("KONSOLE_DBUS_WINDOW")
    if not (win and os.environ.get("KONSOLE_DBUS_SERVICE")): return
    for sid in (qdbus(win, "sessionList") or "").split():
        if qdbus(f"/Sessions/{sid}", "tabTitleFormat", "0") == rel:
            qdbus(win, "setCurrentSession", sid); return
    # Konsole's D-Bus can't run commands in a tab: the new shell starts claude when it finds its folder
    # in this marker (shell/bashrc.sh)
    cwd = str(ROOT if rel == NAME else ROOT / rel)
    (HOME / ".cache/claude/autostart").write_text(cwd + "\n")
    sid = qdbus(win, "newSession", qdbus(win, "defaultProfile") or "", cwd)
    if sid:
        qdbus(win, "setCurrentSession", sid)

MOUSE = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
def handle_input(data):
    """Returns True to quit, False to redraw now, None to keep waiting."""
    if data in ("q", "Q", "\x1b"):
        return True
    redraw = None
    for b, x, y, kind in MOUSE.findall(data):
        if b != "0" or kind != "M": continue                      # left button press only
        if int(y) == 2:                                           # tab bar (second line)
            for start, end, i in TABS:
                if start <= int(x) <= end: VIEW[0] = i; redraw = False
        elif int(y) - 1 in CLICK:
            goto_project(CLICK[int(y) - 1]); redraw = False
    rest = MOUSE.sub("", data)
    for ch in rest:
        if ch in ("q", "Q"): return True
        if ch == "\t": VIEW[0] = 1 - VIEW[0]; redraw = False
        if ch in DISMISS: dismiss(ch); redraw = False
    return redraw

def main():
    if "--once" in sys.argv or not sys.stdout.isatty():
        print("\n".join(frame()))
        return
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    resized = []
    signal.signal(signal.SIGWINCH, lambda *_: resized.append(1))
    konsole_tab(("setTabTitleFormat", "0", TAB_TITLE), ("setTabTitleFormat", "1", TAB_TITLE),
                ("setTabColor", TAB_COLOR))
    subprocess.Popen([Path(__file__).resolve().parent.parent / "hooks/sort-tabs.sh"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)   # DASH tab moves to the front
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1006h")   # alternate screen, hide cursor, mouse clicks
    try:
        tty.setcbreak(fd)
        while True:
            lines = frame()[:shutil.get_terminal_size().lines]
            sys.stdout.write("\x1b[H" + "".join(l + "\x1b[K\n" for l in lines[:-1]) + lines[-1] + "\x1b[K\x1b[J")
            sys.stdout.flush()
            resized.clear()
            deadline = time.time() + REFRESH
            while time.time() < deadline and not resized:
                try:
                    ready, _, _ = select.select([sys.stdin], [], [], max(0, deadline - time.time()))
                except InterruptedError:
                    break                            # window resized: redraw now
                if ready:
                    act = handle_input(os.read(fd, 1024).decode(errors="replace"))
                    if act: return
                    if act is False: break           # redraw now
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        konsole_tab(("setTabTitleFormat", "0", "%d : %n"), ("setTabTitleFormat", "1", "(%u) %H"))   # Konsole defaults
        sys.stdout.write("\x1b[?1006l\x1b[?1000l\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()

main()
