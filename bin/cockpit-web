#!/usr/bin/env -S python3 -I
"""The dashboard as a web page: a small local server (Python stdlib only) for web/index.html and its data.
Installed by install.sh as the systemd user service cockpit-web.service (always on); symlinked to
~/.local/bin/cockpit-web.

  cockpit-web serve     run the server (what the service does); port: cockpit.json "web_port", default 8765
  cockpit-web open      open the page in the browser, unless one is open already (it polls every 2 s);
                        hooks/session-name.sh runs this when a session starts

Only on 127.0.0.1. API (also meant for other clients, e.g. a phone app through a tunnel):
  GET  /api/state       everything the dashboard shows (bin/dashboard snapshot())
  POST /api/open        {"project": row}   go to the project's Konsole tab, or open one running claude
  POST /api/dismiss     {"project": row}   dismiss the row's open questions
  POST /api/tick        {"index": n, "text": item}   tick a to-do item
POSTs need the header "X-Cockpit: 1" and every request a localhost Host header, so other web pages
can't use the API (no cross-site form posts, no DNS rebinding).
"""
import importlib.machinery, json, os, subprocess, sys, threading, time, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
dash = importlib.machinery.SourceFileLoader("dashboard", str(HERE / "bin/dashboard")).load_module()
PORT = int(dash.CONF.get("web_port", 8765))
HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}
LOCK = threading.Lock()          # the dashboard module keeps state in globals
LAST_POLL = [0.0]                # when a page last asked for /api/state

def konsole():
    """Point the dashboard's Konsole calls at a Konsole window: the one holding the workspace root's tab,
    else any. The service runs outside Konsole, so it has no KONSOLE_DBUS_* of its own."""
    names = subprocess.run(["qdbus6"], capture_output=True, text=True).stdout.split()
    best = None
    for svc in (n for n in names if n.startswith("org.kde.konsole")):
        for win in subprocess.run(["qdbus6", svc], capture_output=True, text=True).stdout.split():
            if not win.startswith("/Windows/") or win.count("/") != 2: continue
            os.environ["KONSOLE_DBUS_SERVICE"] = svc
            best = best or (svc, win)
            if any(dash.qdbus(f"/Sessions/{s}", "tabTitleFormat", "0") == dash.NAME
                   for s in (dash.qdbus(win, "sessionList") or "").split()):
                best = (svc, win); break
    if best:
        os.environ["KONSOLE_DBUS_SERVICE"], os.environ["KONSOLE_DBUS_WINDOW"] = best
    return bool(best)

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.headers.get("Host") not in HOSTS: return self.send(403, {"error": "host"})
        if self.path in ("/", "/index.html"):
            return self.send(200, (HERE / "web/index.html").read_bytes(), "text/html; charset=utf-8")
        if self.path == "/api/state":
            LAST_POLL[0] = time.time()
            with LOCK: data, _ = dash.snapshot()
            return self.send(200, data)
        if self.path == "/api/viewers":
            return self.send(200, {"last_poll_age": round(time.time() - LAST_POLL[0], 1)})
        self.send(404, {"error": "not found"})

    def do_POST(self):
        if self.headers.get("Host") not in HOSTS or self.headers.get("X-Cockpit") != "1":
            return self.send(403, {"error": "forbidden"})
        try: body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
        except ValueError: return self.send(400, {"error": "bad json"})
        with LOCK:
            if self.path == "/api/open":
                if not konsole(): return self.send(503, {"error": "no Konsole window"})
                dash.snapshot()                               # fresh ORPHANS / ASKING for that row
                dash.goto_project(str(body.get("project", "")))
            elif self.path == "/api/dismiss":
                _, qfiles = dash.snapshot()
                dash.DISMISS["web"] = qfiles.get(str(body.get("project", "")), [])
                dash.dismiss("web")
            elif self.path == "/api/tick":
                path = dash.todos.todo_file(dash.ROOT, dash.CONF)
                if not path: return self.send(400, {"error": "no todo_file"})
                dash.todos.tick(path, int(body.get("index", -1)), str(body.get("text", "")))
            else:
                return self.send(404, {"error": "not found"})
        self.send(200, {"ok": True})

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "serve"
    url = f"http://127.0.0.1:{PORT}/"
    if cmd == "serve":
        ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
    elif cmd == "open":
        import urllib.request
        try:
            with urllib.request.urlopen(url + "api/viewers", timeout=2) as r:
                if json.load(r)["last_poll_age"] < 10: return     # a page is open
        except (OSError, ValueError, KeyError):
            pass
        stamp = Path.home() / ".cache/claude/web-open.stamp"   # sessions starting together open one page
        try:
            if time.time() - stamp.stat().st_mtime < 20: return
        except OSError: pass
        stamp.touch()
        webbrowser.open_new(url)
    else:
        sys.exit(__doc__)

main()
